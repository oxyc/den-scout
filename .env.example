# Copy to .env for local `go run ./cmd/den-scout` (gitignored). den-scout holds NO debrid secrets:
# the token rides in the addon URL (per install), never the server env. These vars only tune runtime.

# PORT=8080

# Per-indexer scrape timeout and how long a ranked stream list stays cached, both in seconds.
# SCRAPE_TIMEOUT_SECS=8
# LIST_TTL_SECS=300

# In-memory list-cache byte budget (default 48 MiB) and the external origin used to mint /play URLs.
# When PUBLIC_BASE_URL is set, X-Forwarded-* / Host headers are ignored.
# MEMORY_CACHE_BYTES=50331648
# PUBLIC_BASE_URL=https://scout.example.com

# Where the durable cache tier writes (default: a den-scout-cache dir under the system temp dir; /cache
# in the container image). It holds stream lists and 30-day track probes, and a probe costs a debrid
# resolve to rebuild — so under a read-only container this MUST point at a writable mount or persistence
# disables itself after one log line. Check scout_cache_persistent on /metrics.
# CACHE_DIR=/cache

# One log line per response, `<METHOD> <path> <status> <ms>ms`, with the config segment and /play token
# replaced and the query string dropped. Off when unset, empty or "0"; any other value turns it on.
# LOG_REQUESTS=0

# Metadata source for the mistagged-torrent filter (title, plus a release year for movies).
# CINEMETA_URL=https://v3-cinemeta.strem.io

# Bearer token for /metrics. Unset and the route 404s — the counters describe when this install is being
# watched (a cache miss per title opened cold) and which indexers it has configured, which is not public
# information even though no debrid service or account appears in them.
# METRICS_TOKEN=

# Sealed config-in-URL (docs/SEALED-CONFIG.md). CONFIG_KEY is a base64 32-byte X25519 PRIVATE key;
# with it set, /configure seals the config in the browser and the addon URL carries ciphertext instead of
# your debrid token. Unset = legacy plaintext URLs, which still work. CONFIG_KEYS_PREV holds prior
# keys (comma-separated) so rotating does not break links already installed.
# CONFIG_KEY=
# CONFIG_KEYS_PREV=

# Let scout mint comet's / mediafusion's per-install config segments from the debrid account it already
# holds, instead of skipping those indexers for want of a pasted URL. THIS SENDS THE DEBRID TOKEN TO
# THOSE HOSTS, so it is off unless you turn it on; an explicit COMET_URL / MEDIAFUSION_URL always wins.
# MINT_INDEXER_CONFIGS=false

# Per-indexer base-URL overrides. Point these at self-hosted instances, or supply MediaFusion's
# base WITH its encrypted-config segment (it 401s without one). Defaults are the public instances.
# TORRENTIO_URL=https://torrentio.strem.fun
# COMET_URL=https://comet.elfhosted.com
# MEDIAFUSION_URL=https://mediafusion.elfhosted.com/<encrypted-config>
# TORZ_URL=https://torz.strem.fun
